# ─────────────────────────────────────────────────────────────────────────
#  PRODUCCIÓN — galeria.dvloprbn.dev
#
#  Copia a ".env.prod" (ignorado por git) y rellena los valores reales.
#  Arranca con:
#    docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# ─────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# --- Dominio (lo usa Caddy) ---
SITE_DOMAIN=galeria.dvloprbn.dev
# Para probar en local sin dominio ni TLS: SITE_DOMAIN=http://localhost

# --- PostgreSQL (red interna; sin puerto publicado) ---
POSTGRES_USER=gallery_user
POSTGRES_PASSWORD=            # openssl rand -hex 24
POSTGRES_DB=gallery_db
DATABASE_URL=postgresql://gallery_user:CONTRASENA_AQUI@gallery_db:5432/gallery_db?schema=public

# --- Redis (red interna; sin puerto publicado) ---
REDIS_PASSWORD=              # openssl rand -hex 24
REDIS_URL=redis://:CONTRASENA_AQUI@gallery_redis:6379

# --- Auth ---
JWT_SECRET=                  # openssl rand -base64 48 — PROPIO de este proyecto
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
TOTP_ENCRYPTION_KEY=         # openssl rand -hex 32  (64 caracteres)

# --- Firma de URLs de media privada ---
MEDIA_URL_SIGNING_SECRET=    # openssl rand -base64 32
MEDIA_SIGNED_URL_TTL_SECONDS=300
MEDIA_HLS_URL_TTL_SECONDS=3600      # TTL de URLs firmadas de segmentos/playlists HLS de un album privado (Fase 14c)

# --- Almacenamiento: Cloudinary (cuenta compartida con el portafolio DvloprBn) ---
STORAGE_DRIVER=cloudinary
STORAGE_DISK_ROOT=/app/storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=gallery

# --- Límites de subida ---
UPLOAD_MAX_FILE_BYTES=15728640          # por IMAGEN
UPLOAD_MAX_IMAGE_PIXELS=50000000
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/avif
UPLOAD_MAX_UPLOADS_PER_HOUR=120         # subidas/usuario/hora antes de 429

# --- Límites de video (Fase 14) ---
VIDEO_MAX_INPUT_BYTES=209715200        # 200 MiB por archivo de video
VIDEO_MAX_DURATION_S=120
VIDEO_MAX_PIXELS=2073600               # 1920x1080
VIDEO_MAX_FRAME_RATE=121
VIDEO_TRANSCODE_TIMEOUT_MS=600000

# --- Correo (Resend, misma llave que el portafolio) ---
RESEND_API_KEY=
MAIL_FROM_ADDRESS=no-reply@dvloprbn.dev

# --- Un solo origen: sin CORS entre frontend y API ---
GLOBAL_PREFIX=api
ALLOWED_ORIGINS=https://galeria.dvloprbn.dev
FRONTEND_URL=https://galeria.dvloprbn.dev
BACKEND_URL=https://galeria.dvloprbn.dev/api
# Cookie host-only en el subdominio (no compartida con el portafolio):
COOKIE_DOMAIN=
