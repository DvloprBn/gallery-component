// Schema de la Galería — congelado 2026-09-01 (ver DOCUMENTO_VIVO_ARQUITECTURA.md §1.3).
// Cambios posteriores van por migración, nunca editando una migración ya aplicada.

// Prisma 7: la URL de conexión ya NO vive aquí — está en ../prisma.config.ts
// (para el CLI de Migrate) y se pasa al PrismaClient vía un driver adapter
// (@prisma/adapter-pg) en src/common/prisma/prisma.service.ts.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── IDENTIDAD ───────────────────────────

// Roles dinámicos — nunca un enum fijo de Postgres. `level` es el nivel de
// autoridad (0 = usuario público … N = superadministrador). `max_count`
// limita cuántas cuentas ACTIVAS pueden tener ese rol (null = sin límite).
// `is_system` marca los roles sembrados para que no se puedan borrar y
// dejar el sistema sin acceso administrativo.
model roles {
  role_id     Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(200)
  level       Int      @default(0)
  max_count   Int?
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users[]
}

model users {
  user_id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String  @unique @db.VarChar(255)
  password_hash        String
  name                 String? @db.VarChar(150)
  role_id              Int
  must_change_password Boolean @default(false)
  is_active            Boolean @default(true)

  // 2FA (TOTP). El secreto es SIMÉTRICO: el servidor necesita leerlo de
  // vuelta para verificar el código de la app del usuario, así que se
  // CIFRA en reposo (AES-256-GCM, llave propia en variable de entorno —
  // nunca el JWT_SECRET), no se hashea.
  totp_secret_encrypted String?
  totp_enabled          Boolean @default(false)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  roles                 roles                   @relation(fields: [role_id], references: [role_id], onDelete: Restrict)
  refresh_tokens        refresh_tokens[]
  password_reset_tokens password_reset_tokens[]
  totp_recovery_codes   totp_recovery_codes[]
  albums                albums[]
  media                 media[]

  @@index([role_id])
}

// Rotación con ventana de gracia. Si un token ya usado se vuelve a
// presentar FUERA de la ventana de gracia -> se revocan TODAS las sesiones
// de esa cuenta (asume robo del token).
model refresh_tokens {
  token_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  revoked    Boolean   @default(false)
  used_at    DateTime? @db.Timestamptz(6)
  ip_address String?   @db.VarChar(45)
  user_agent String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  expires_at DateTime  @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

// Códigos de recuperación de 2FA — un solo uso, se muestran UNA vez al
// activar 2FA, se guardan hasheados (bcrypt) porque nunca necesitan
// volver a mostrarse, solo compararse.
model totp_recovery_codes {
  code_id    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  code_hash  String
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model password_reset_tokens {
  token_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  expires_at DateTime  @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

// Fuerza bruta (login y 2FA) y reuso de refresh token. Conteo en Redis
// con ventana deslizante; la fila real solo se crea al cruzar el umbral.
model security_events {
  security_event_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fingerprint       String    @unique @db.VarChar(64)
  type              String    @db.VarChar(30) // login_bruteforce | twofactor_bruteforce | refresh_token_reuse | upload_abuse
  identifier        String
  ip_address        String?   @db.VarChar(45)
  user_agent        String?
  attempts          Int
  occurrence_count  Int       @default(1)
  status            String    @default("nuevo") @db.VarChar(20)
  first_seen_at     DateTime  @default(now()) @db.Timestamptz(6)
  last_seen_at      DateTime  @default(now()) @db.Timestamptz(6)
  resolved_at       DateTime? @db.Timestamptz(6)
  resolved_note     String?
}

// ─────────────────────────── MEDIA / GALERÍA ───────────────────────────

// Un álbum es la unidad de personalización y de visibilidad.
//   public   -> indexable, visible en listados
//   unlisted -> accesible solo con el slug/enlace, no listado
//   private  -> solo el dueño y roles administrativos
// `layout` y `theme` viven en el álbum, no en cada imagen: son la
// "personalización de grado profesional" del proyecto.
model albums {
  album_id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_user_id  String   @db.Uuid
  title          String   @db.VarChar(150)
  slug           String   @unique @db.VarChar(180)
  description    String?  @db.VarChar(2000)
  visibility     String   @default("private") @db.VarChar(20)
  layout         String   @default("masonry") @db.VarChar(20) // masonry | justified | grid | carousel
  theme          Json     @default("{}") // tokens de diseño (colores, tipografía, radios, espaciado, motion)
  cover_media_id String?  @db.Uuid
  sort_order     Int      @default(0)
  featured       Boolean  @default(false) // se muestra en la portada del sitio
  media_count    Int      @default(0) // desnormalizado, mantenido dentro de la misma transacción
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  owner        users                @relation(fields: [owner_user_id], references: [user_id], onDelete: Cascade)
  media        media[]
  share_tokens album_share_tokens[]

  @@index([owner_user_id])
  @@index([visibility])
}

// Tipo de un elemento de `media`. La galería, la protección (marca de agua +
// derechos) y el licenciamiento son iguales para foto y video; lo que cambia
// es el pipeline de ingesta y la forma de entrega (ver Fase 14,
// `DOCUMENTO_VIVO_ARQUITECTURA.md` §19).
enum media_kind {
  photo
  video
}

// El elemento ORIGINAL subido, ya normalizado (re-encode con sharp/ffmpeg, sin
// metadatos). `storage_key` es la ruta opaca dentro del StorageService (nunca
// el nombre original del cliente). `checksum_sha256` permite deduplicar y
// detectar corrupción. El original re-encodeado se guarda para poder regenerar
// derivados en el futuro, pero NUNCA se sirve directo a la galería.
model media {
  media_id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  album_id        String     @db.Uuid
  owner_user_id   String     @db.Uuid
  kind            media_kind @default(photo)
  storage_key     String     @unique
  original_name   String?    @db.VarChar(255) // saneado, solo para mostrar/descargar
  mime_type       String     @db.VarChar(50) // detectado por contenido, no por extensión
  width           Int
  height          Int
  bytes           Int
  checksum_sha256 String     @db.VarChar(64)
  placeholder     String?    @db.VarChar(120) // blurhash o color dominante
  alt_text        String?    @db.VarChar(500)
  caption         String?    @db.VarChar(2000)
  sort_order      Int        @default(0)
  // Estado de curación: 'archived' (subida, fuera del portafolio) | 'draft'
  // (en preparación) | 'published' (visible en la galería pública). Las subidas
  // nuevas entran como 'draft' — se sube en ancho y se cura después.
  status          String     @default("draft") @db.VarChar(16)
  // Registro de derechos de ESTE elemento (Fase 11). `null` = hereda por
  // completo los valores por defecto de `site_settings`. Forma:
  // { rightsHolder?, creator?, creditLine?, rightsStatement?, licenseTerms?, licensorUrl? }.
  // Es lo que se incrusta como IPTC/XMP en cada archivo servido.
  rights          Json?
  created_at      DateTime   @default(now()) @db.Timestamptz(6)

  album            albums             @relation(fields: [album_id], references: [album_id], onDelete: Cascade)
  owner            users              @relation(fields: [owner_user_id], references: [user_id], onDelete: Cascade)
  variants         media_variants[]
  license_requests license_requests[]
  licenses         licenses[]

  @@index([album_id])
  @@index([album_id, status])
  @@index([owner_user_id])
}

/**
 * Solicitud de licencia (Fase 12a): un visitante pide usar UNA foto para un
 * uso concreto. Primer paso del flujo solicitud → cotización → entrega — por
 * ahora solo se captura y se avisa por correo; cotizar/aceptar/entregar
 * llegan en fases posteriores.
 */
model license_requests {
  request_id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  media_id        String   @db.Uuid
  requester_name  String   @db.VarChar(150)
  requester_email String   @db.VarChar(255)
  // 'editorial' | 'commercial' | 'social' | 'print'.
  intended_use    String   @db.VarChar(20)
  message         String   @db.VarChar(2000) // descripción del uso / alcance
  budget          String?  @db.VarChar(200) // texto libre — no se fuerza moneda ni monto
  // 'new' | 'quoted' | 'accepted' | 'declined' | 'fulfilled'.
  status          String   @default("new") @db.VarChar(20)
  ip_address      String?  @db.VarChar(45) // solo registro interno, nunca se expone
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  // ── Cotización (Fase 12b) — la pone el gestor al responder ──
  quoted_price      String?   @db.VarChar(200) // texto libre — no se fuerza moneda ni monto
  quoted_conditions String?   @db.VarChar(1000) // alcance/vigencia de la licencia ofrecida, en prosa
  quote_expires_at  DateTime? @db.Timestamptz(6) // hasta cuándo es válida ESTA cotización
  quoted_at         DateTime? @db.Timestamptz(6)

  media   media     @relation(fields: [media_id], references: [media_id], onDelete: Cascade)
  license licenses?

  @@index([status, created_at])
  @@index([media_id])
}

/**
 * Licencia emitida (Fase 12c) — se crea al aceptar una solicitud ya cotizada.
 * 1:1 con la solicitud que la originó; guarda una copia de los términos
 * (precio/condiciones) tal como se aceptaron, independiente de que la
 * cotización de la solicitud se edite después.
 */
model licenses {
  license_id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id     String   @unique @db.Uuid
  media_id       String   @db.Uuid
  licensee_name  String   @db.VarChar(150)
  licensee_email String   @db.VarChar(255)
  intended_use   String   @db.VarChar(20)
  price          String?  @db.VarChar(200)
  conditions     String?  @db.VarChar(1000)
  issued_at      DateTime @default(now()) @db.Timestamptz(6)

  request         license_requests  @relation(fields: [request_id], references: [request_id], onDelete: Cascade)
  media           media             @relation(fields: [media_id], references: [media_id], onDelete: Cascade)
  delivery_tokens delivery_tokens[]

  @@index([media_id])
}

/**
 * Entrega de un solo uso (Fase 12c): la URL que recibe el licenciatario por
 * correo. Mismo patrón que `album_share_tokens` (`token_hash` = sha256 del
 * token opaco, nunca el token en claro) más `used_at` — a diferencia de un
 * enlace de compartir (válido hasta que expira o se revoca), este se
 * **consume**: la primera descarga exitosa lo inutiliza.
 */
model delivery_tokens {
  delivery_token_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  license_id        String    @db.Uuid
  token_hash        String    @unique @db.VarChar(64)
  expires_at        DateTime  @db.Timestamptz(6)
  used_at           DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)

  license licenses @relation(fields: [license_id], references: [license_id], onDelete: Cascade)

  @@index([license_id])
}

// Derivados responsivos generados por el pipeline. Se sirven ESTOS, nunca
// el original. `format` moderno (webp/avif) con fallback jpeg para foto; para
// video, las renditions HLS y el preview progresivo (ver Fase 14).
model media_variants {
  variant_id  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  media_id    String   @db.Uuid
  storage_key String   @unique
  label       String   @db.VarChar(20) // thumb | small | medium | large
  format      String   @db.VarChar(10) // webp | avif | jpeg
  width       Int
  height      Int
  bytes       Int
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  media media @relation(fields: [media_id], references: [media_id], onDelete: Cascade)

  @@unique([media_id, label, format])
  @@index([media_id])
}

// Enlace de acceso a un álbum unlisted/private con caducidad opcional.
// Distinto de la URL firmada de cada archivo: esto da acceso al ÁLBUM.
model album_share_tokens {
  share_token_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  album_id       String    @db.Uuid
  token_hash     String    @unique
  expires_at     DateTime? @db.Timestamptz(6)
  revoked        Boolean   @default(false)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  album albums @relation(fields: [album_id], references: [album_id], onDelete: Cascade)

  @@index([album_id])
}

// ─────────────────────────── SITIO (PORTAFOLIO) ───────────────────────────

// Fila única (id = 1) con los textos e imagen que dan al sitio su identidad
// de portafolio: nombre del/la fotógrafo/a, declaración, "sobre mí", contacto.
model site_settings {
  id             Int      @id @default(1)
  site_title     String   @default("Portafolio") @db.VarChar(120)
  owner_name     String   @default("") @db.VarChar(120)
  tagline        String   @default("") @db.VarChar(200)
  bio            String   @default("") @db.VarChar(600) // frase(s) para la portada
  about_body     String   @default("") // texto largo de la página "Sobre mí"
  contact_email  String   @default("") @db.VarChar(255)
  contact_intro  String   @default("") @db.VarChar(600)
  instagram      String   @default("") @db.VarChar(200)
  hero_media_id  String?  @db.Uuid // foto o video a sangre completa de la portada

  // ── Marca de agua (Fase 11, D9) — obligatoria en todo lo `public` ──
  // Clave de almacenamiento del PNG subido por el gestor; null = usar texto.
  watermark_asset_key String  @default("") @db.VarChar(255)
  // Texto de respaldo si no hay PNG subido (si también está vacío, se usa
  // "© {owner_name}" calculado en tiempo de estampado).
  watermark_text       String  @default("") @db.VarChar(120)
  watermark_opacity    Float   @default(0.35)
  // 'tiled' (patrón diagonal repetido) | 'corner' (una sola vez, esquina).
  watermark_placement  String  @default("tiled") @db.VarChar(16)

  // ── Registro de derechos por defecto (Fase 11, D10) ──
  // Se incrusta como IPTC/XMP en cada archivo servido; una imagen puede
  // sobreescribir cualquier campo en `images.rights`.
  rights_holder          String @default("") @db.VarChar(160)
  creator                String @default("") @db.VarChar(160)
  credit_line            String @default("") @db.VarChar(200)
  rights_statement       String @default("") @db.VarChar(400)
  default_license_terms  String @default("") @db.VarChar(400)
  licensor_url           String @default("") @db.VarChar(300)

  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

// Mensajes del formulario de contacto público. Se guardan para poder
// revisarlos en el panel además de intentar el envío por correo.
model contact_messages {
  message_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @db.VarChar(150)
  email      String   @db.VarChar(255)
  body       String   @db.VarChar(4000)
  ip_address String?  @db.VarChar(45)
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([is_read, created_at])
}
