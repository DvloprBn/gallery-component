# Imagen de DESARROLLO — el código llega por un volumen bind (docker-compose)
# y NestJS recompila en caliente. No es la imagen de producción.

FROM node:22-bookworm-slim

# openssl -> lo necesita el motor de Prisma en tiempo de ejecución.
# ca-certificates -> peticiones HTTPS salientes (Resend, Cloudinary).
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copiamos solo los manifiestos primero: si no cambian, Docker reutiliza
# la capa de `npm install` cacheada y no reinstala en cada build.
COPY package.json package-lock.json* ./
RUN npm install

# El resto del código real se monta por volumen en docker-compose; este COPY
# solo cubre el caso de construir la imagen sin el volumen.
COPY . .

EXPOSE 3040

CMD ["npm", "run", "start:dev"]
