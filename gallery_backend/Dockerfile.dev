# Imagen de DESARROLLO — el código llega por un volumen bind (docker-compose)
# y NestJS recompila en caliente. No es la imagen de producción.

FROM node:22-bookworm-slim

# openssl        -> lo necesita el motor de Prisma en tiempo de ejecución.
# ca-certificates -> peticiones HTTPS salientes (Resend, Cloudinary).
# fontconfig + fuente -> para que sharp/librsvg rasterice texto en SVG (el
#   seed de demostración y la marca de agua de texto, Fase 11).
# libimage-exiftool-perl -> embebe los metadatos IPTC/XMP de derechos
#   (Fase 11, D10). Se invoca siempre con `execFile` (nunca `exec`/shell) y
#   una lista fija de etiquetas — ver `src/protection/rights-metadata.service.ts`.
# ffmpeg (trae ffprobe) -> valida por contenido, re-encoda y saca póster/preview
#   del video (Fase 14). Se invoca con `execFile` + array de argumentos, nunca
#   shell, y con `-protocol_whitelist file,crypto` (sin red) — ver
#   `src/media-processing/video-pipeline.service.ts`.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       openssl ca-certificates fontconfig fonts-dejavu-core libimage-exiftool-perl ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copiamos solo los manifiestos primero: si no cambian, Docker reutiliza
# la capa de `npm install` cacheada y no reinstala en cada build.
COPY package.json package-lock.json* ./
RUN npm install

# El resto del código real se monta por volumen en docker-compose; este COPY
# solo cubre el caso de construir la imagen sin el volumen.
COPY . .

EXPOSE 3040

CMD ["npm", "run", "start:dev"]
