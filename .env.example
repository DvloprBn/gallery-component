# ─────────────────────────────────────────────────────────────────────────
#  Galería — variables de entorno
#
#  Copia este archivo a ".env" y rellena los valores reales.
#  ".env" NUNCA se sube a git (ya está en .gitignore).
#  Genera secretos con:   openssl rand -base64 48      (o -hex 32 donde se indique)
# ─────────────────────────────────────────────────────────────────────────

# --- Entorno ---
NODE_ENV=development

# --- PostgreSQL (servicio gallery_db) ---
POSTGRES_USER=gallery_user
POSTGRES_PASSWORD=            # openssl rand -base64 24
POSTGRES_DB=gallery_db
# El host "gallery_db" es el nombre del servicio en docker-compose (red interna de Docker).
DATABASE_URL=postgresql://gallery_user:CONTRASENA_AQUI@gallery_db:5432/gallery_db?schema=public

# --- Redis (servicio gallery_redis) ---
REDIS_PASSWORD=              # openssl rand -base64 24
REDIS_URL=redis://:CONTRASENA_AQUI@gallery_redis:6379

# --- Auth (JWT) ---
# PROPIO de este proyecto — nunca el mismo valor que otro proyecto (un token
# de otro sistema jamás debe validar aquí).
JWT_SECRET=                  # openssl rand -base64 48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- 2FA: cifrado del secreto TOTP en reposo (AES-256-GCM) ---
# EXACTAMENTE 32 bytes en hex = 64 caracteres:   openssl rand -hex 32
# Nunca el mismo valor que JWT_SECRET (responsabilidades distintas).
TOTP_ENCRYPTION_KEY=

# --- Firma de URLs de media privada (HMAC) ---
MEDIA_URL_SIGNING_SECRET=    # openssl rand -base64 32
MEDIA_SIGNED_URL_TTL_SECONDS=300

# --- Almacenamiento de imágenes ---
# STORAGE_DRIVER:  "disk" en desarrollo  |  "cloudinary" en producción
STORAGE_DRIVER=disk
# Driver disco: ruta dentro del contenedor (montada como volumen en docker-compose).
STORAGE_DISK_ROOT=/app/storage
# Driver Cloudinary. Este proyecto comparte dominio con el portafolio DvloprBn y
# reutiliza SU cuenta de Cloudinary (mismas credenciales que el .env de ese
# proyecto). CLOUDINARY_FOLDER aísla los recursos de la galería dentro de esa
# cuenta compartida. El backend valida al arrancar: si STORAGE_DRIVER=cloudinary,
# las tres CLOUDINARY_* son obligatorias.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=gallery

# --- Límites de subida (defensa contra DoS de imagen) ---
UPLOAD_MAX_FILE_BYTES=15728640          # 15 MiB por archivo (corte en el interceptor)
UPLOAD_MAX_IMAGE_PIXELS=50000000        # 50 MP — corte de decompression bomb (sharp limitInputPixels)
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/avif

# --- Correo (Resend) ---
# Se reutiliza la MISMA llave de Resend que el portafolio DvloprBn (mismo dominio).
# Con un valor falso el backend arranca igual; el envío real fallará y quedará
# registrado (MailService.send nunca truena el flujo).
RESEND_API_KEY=re_placeholder_reemplazar_con_llave_real
MAIL_FROM_ADDRESS=no-reply@example.com

# --- CORS ---
# Orígenes autorizados separados por coma. Nunca "*". En desarrollo, el frontend.
ALLOWED_ORIGINS=http://localhost:3051

# --- URLs públicas ---
FRONTEND_URL=http://localhost:3051
BACKEND_URL=http://localhost:3050

# --- Puertos host (solo los lee docker-compose) ---
BACKEND_PORT=3050
FRONTEND_PORT=3051
DB_PORT=5438
REDIS_PORT=6383
